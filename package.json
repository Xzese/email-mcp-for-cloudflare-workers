{
	"name": "email-mcp-server",
	"version": "1.0.0",
	"private": true,
	"description": "A Cloudflare Workers MCP server for Gmail, Outlook, iCloud, and custom IMAP/SMTP accounts.",
	"keywords": [
		"cloudflare-workers",
		"email",
		"imap",
		"mcp",
		"model-context-protocol",
		"smtp"
	],
	"homepage": "https://github.com/Xzese/email-mcp-server#readme",
	"bugs": {
		"url": "https://github.com/Xzese/email-mcp-server/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Xzese/email-mcp-server.git"
	},
	"type": "module",
	"scripts": {
		"postinstall": "npm run cf-typegen",
		"cloudflare:config": "node scripts/generate-cloudflare-config.mjs",
		"cloudflare:deploy": "npm run cloudflare:config && wrangler deploy --config wrangler.generated.json",
		"cloudflare:upload": "npm run cloudflare:config && wrangler versions upload --config wrangler.generated.json",
		"deploy": "wrangler deploy --config wrangler.production.toml",
		"dev": "wrangler dev",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix",
		"dependencies:check": "npm ls agents @modelcontextprotocol/sdk",
		"build:check": "wrangler deploy --dry-run --outdir dist",
		"start": "wrangler dev",
		"test": "npm run type-check && node --test tests/*.test.ts",
		"cf-typegen": "wrangler types --env-file .dev.vars.example --strict-vars=false",
		"cf-typegen:check": "wrangler types --env-file .dev.vars.example --strict-vars=false --check",
		"public-config:check": "node scripts/check-public-config.mjs",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"agents": "^0.26.0",
		"hono": "^4.13.13",
		"jose": "^6.2.12",
		"mailparser": "^3.9.36",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/mailparser": "^3.9.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"typescript": "7.0.2",
		"wrangler": "^4.147.0"
	},
	"overrides": {
		"body-parser": "2.3.0",
		"brace-expansion": "5.0.8",
		"fast-uri": "3.1.4"
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
